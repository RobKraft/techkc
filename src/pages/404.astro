---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
    <div class="text-7xl font-extrabold text-brand-100 mb-4">404</div>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">Page not found</h1>
    <p class="text-slate-500 mb-8">That page doesn't exist. Try navigating from the home page.</p>
    <a href="/" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg text-sm transition-colors">
      Back to home
    </a>
  </div>
</Layout>
