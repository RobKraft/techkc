---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import events from '../data/events.json';

const YEAR = 2026;
const MONTH_NAMES = [
  'January','February','March','April','May','June',
  'July','August','September','October','November','December',
];
const DAY_ABBR = ['Su','Mo','Tu','We','Th','Fr','Sa'];

// ── Calendar data: expand multi-day ranges into per-date maps ─────────────
const dateTypeMap  = new Map<string, string>(); // date → first event type
const dateTitleMap = new Map<string, string>(); // date → tooltip text

for (const ev of events) {
  if ((ev as any).dateTBD) continue;
  const start = new Date(ev.date + 'T12:00:00');
  const end   = ev.endDate ? new Date(ev.endDate + 'T12:00:00') : start;
  for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
    const k = d.toISOString().slice(0, 10);
    if (!dateTypeMap.has(k)) dateTypeMap.set(k, ev.type);
    const cur = dateTitleMap.get(k);
    dateTitleMap.set(k, cur ? `${cur} · ${ev.name}` : ev.name);
  }
}

const monthHasTBD = MONTH_NAMES.map((_, m) =>
  events.some(e => (e as any).dateTBD && new Date(e.date + 'T12:00:00').getMonth() === m)
);

function calCells(month: number): (number | null)[] {
  const firstDay = new Date(YEAR, month, 1).getDay();
  const days     = new Date(YEAR, month + 1, 0).getDate();
  const arr: (number | null)[] = [
    ...Array(firstDay).fill(null),
    ...Array.from({ length: days }, (_, i) => i + 1),
  ];
  while (arr.length % 7 !== 0) arr.push(null);
  return arr;
}

const TYPE_BG: Record<string, string> = {
  Conference:   'bg-purple-500',
  Hackathon:    'bg-pink-500',
  Workshop:     'bg-amber-500',
  Unconference: 'bg-teal-500',
};

// Left border colours for the event list
const TYPE_BORDER: Record<string, string> = {
  Conference:   'border-purple-400',
  Hackathon:    'border-pink-400',
  Workshop:     'border-amber-400',
  Unconference: 'border-teal-400',
};

// Pre-compute per-month event lists for the sidebar
const sorted = [...events].sort((a, b) => a.date.localeCompare(b.date));

function fmtDateRange(ev: (typeof events)[0]): string {
  if ((ev as any).dateTBD) {
    return new Date(ev.date + 'T12:00:00').toLocaleDateString('en-US', { month: 'long' }) + ' (date TBD)';
  }
  const s = new Date(ev.date + 'T12:00:00');
  const e = ev.endDate ? new Date(ev.endDate + 'T12:00:00') : null;
  if (e && ev.endDate !== ev.date) {
    return `${s.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}–${e.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`;
  }
  return s.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

// ── Filter dropdowns ──────────────────────────────────────────────────────
const regions = [...new Set(events.map(e => {
  const l = e.location;
  if (l.includes('Kansas City') || l === 'Virtual') return 'Kansas City / Virtual';
  if (l.includes('MO') || l.includes('St. Louis')) return 'Missouri';
  if (l.includes('NE') || l.includes('Omaha') || l.includes('Lincoln')) return 'Nebraska';
  if (l.includes('OK')) return 'Oklahoma';
  if (l.includes('IA')) return 'Iowa';
  return 'Other';
}))].sort();
---

<Layout title="Events" description="Tech conferences, hackathons, and events in and around Kansas City for 2026.">

  <!-- Page header -->
  <section class="bg-slate-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3">Regional Events</h1>
      <p class="text-slate-300 text-lg max-w-2xl">
        Conferences, hackathons, and workshops in and around Kansas City for {YEAR}.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- ── Filters ──────────────────────────────────────────────────────── -->
    <div class="flex flex-col sm:flex-row gap-3">
      <input
        id="search"
        type="search"
        placeholder="Search events…"
        class="flex-1 px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />

      <select id="region-filter" class="px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white">
        <option value="">All locations</option>
        {regions.map(r => <option value={r}>{r}</option>)}
      </select>
    </div>

    <!-- ── Single-month calendar ────────────────────────────────────────── -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 sm:p-5">

      <!-- Nav bar -->
      <div class="flex items-center gap-3 mb-4">
        <button
          id="cal-prev"
          aria-label="Previous month"
          class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-600
                 hover:bg-slate-100 hover:border-slate-300 transition-colors disabled:opacity-30 disabled:pointer-events-none"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <span id="cal-month-label" class="flex-1 text-center font-semibold text-slate-800 text-base sm:text-lg"></span>

        <button
          id="cal-next"
          aria-label="Next month"
          class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-600
                 hover:bg-slate-100 hover:border-slate-300 transition-colors disabled:opacity-30 disabled:pointer-events-none"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

      </div>

      <!-- Calendar grid + event list side by side -->
      <div class="flex flex-col md:flex-row gap-5">

        <!-- Calendar grid (one per month, hidden by default, shown via JS) -->
        <div class="md:w-64 lg:w-72 shrink-0">
          <!-- Day-of-week header (static) -->
          <div class="grid grid-cols-7 mb-1">
            {DAY_ABBR.map(d => (
              <div class="text-center text-xs font-medium text-slate-400 py-1">{d}</div>
            ))}
          </div>

          {MONTH_NAMES.map((_, month) => (
            <div id={`cal-grid-${month}`} class="month-cal-grid hidden grid grid-cols-7 gap-0.5">
              {calCells(month).map(day => {
                if (day === null) return <div />;
                const key  = `${YEAR}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const type = dateTypeMap.get(key);
                const tip  = dateTitleMap.get(key);
                const bg   = type ? (TYPE_BG[type] ?? 'bg-brand-500') : '';
                return (
                  <div
                    data-caldate={key}
                    title={tip}
                    class={`aspect-square flex items-center justify-center text-sm rounded-full leading-none select-none
                      ${type
                        ? `${bg} text-white font-bold cursor-default`
                        : 'text-slate-600 hover:bg-slate-100 cursor-default'}`}
                  >
                    {day}
                  </div>
                );
              })}
            </div>
          ))}

          <!-- Type legend -->
          <div class="mt-3 pt-3 border-t border-slate-100 flex flex-wrap gap-x-3 gap-y-1">
            {Object.entries(TYPE_BG).map(([type, bg]) => (
              <span class="flex items-center gap-1 text-xs text-slate-500">
                <span class={`w-2 h-2 rounded-full ${bg} inline-block shrink-0`}></span>
                {type}
              </span>
            ))}
            {monthHasTBD.some(Boolean) && (
              <span class="flex items-center gap-1 text-xs text-amber-600">
                <span class="font-bold">TBD</span> = date unconfirmed
              </span>
            )}
          </div>
        </div>

        <!-- Per-month event list (one per month, hidden by default) -->
        <div class="flex-1 min-w-0">
          {MONTH_NAMES.map((name, month) => {
            const monthEvts = sorted.filter(e =>
              new Date(e.date + 'T12:00:00').getMonth() === month
            );
            return (
              <div id={`month-list-${month}`} class="month-events-list hidden">
                {monthEvts.length === 0
                  ? (
                    <p class="text-sm text-slate-400 italic py-4 text-center">
                      No events in {name}.
                    </p>
                  )
                  : (
                    <div class="space-y-2">
                      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">
                        {monthEvts.length} event{monthEvts.length !== 1 ? 's' : ''} in {name}
                      </p>
                      {monthEvts.map(ev => {
                        const bc = TYPE_BORDER[ev.type] ?? 'border-brand-400';
                        const dateStr = fmtDateRange(ev);
                        return (
                          <a
                            href={ev.url}
                            target="_blank"
                            rel="noopener"
                            class={`flex flex-col gap-0.5 px-3 py-2.5 rounded-lg border-l-4 ${bc} bg-slate-50
                                    hover:bg-slate-100 transition-colors group`}
                          >
                            <span class="text-sm font-semibold text-slate-900 group-hover:text-brand-700 transition-colors leading-snug">
                              {ev.name}
                            </span>
                            <span class="text-xs text-slate-500">
                              {dateStr}
                              {ev.location !== 'Kansas City, MO' && (
                                <span class="ml-1 text-slate-400">· {ev.location}</span>
                              )}
                              {(ev as any).dateTBD && (
                                <span class="ml-1 text-amber-600 font-medium">(date TBD)</span>
                              )}
                            </span>
                          </a>
                        );
                      })}
                    </div>
                  )
                }
              </div>
            );
          })}
        </div>

      </div>
    </div>

    <!-- ── Cards grid ────────────────────────────────────────────────────── -->
    <div id="events-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sorted.map(event => {
        const l = event.location;
        let region = 'Other';
        if (l.includes('Kansas City') || l === 'Virtual') region = 'Kansas City / Virtual';
        else if (l.includes('MO') || l.includes('St. Louis')) region = 'Missouri';
        else if (l.includes('NE') || l.includes('Omaha') || l.includes('Lincoln')) region = 'Nebraska';
        else if (l.includes('OK')) region = 'Oklahoma';
        else if (l.includes('IA')) region = 'Iowa';
        return (
          <div
            class="event-item"
            data-date={event.date}
            data-enddate={event.endDate ?? event.date}
            data-month={new Date(event.date + 'T12:00:00').getMonth()}
            data-name={event.name.toLowerCase()}
            data-description={event.description.toLowerCase()}
            data-type={event.type.toLowerCase()}
            data-region={region}
          >
            <EventCard event={event} />
          </div>
        );
      })}
    </div>

    <p id="no-results" class="hidden text-center text-slate-500 py-12 text-sm">
      No events match your filters.
      <a href="/submit#event" class="text-brand-600 hover:underline">Know of one? Add it.</a>
    </p>

  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-center">
      <p class="text-slate-600 mb-3">Know of a regional tech event that isn't listed?</p>
      <a href="/submit#event" class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg text-sm transition-colors">
        Submit an event &rarr;
      </a>
    </div>
  </section>

</Layout>

<script>
  const MONTH_NAMES = ['January','February','March','April','May','June',
    'July','August','September','October','November','December'];
  const YEAR = 2026;

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  // Start on today's month if we're in 2026, else Jan
  let calMonth = (today.getFullYear() === YEAR) ? today.getMonth() : 0;

  // ── DOM refs ──────────────────────────────────────────────────────────────
  const prevBtn        = document.getElementById('cal-prev')!    as HTMLButtonElement;
  const nextBtn        = document.getElementById('cal-next')!    as HTMLButtonElement;
  const monthLabel     = document.getElementById('cal-month-label')!;
  const items          = document.querySelectorAll<HTMLElement>('.event-item');
  const noResults      = document.getElementById('no-results')!;
  const searchEl       = document.getElementById('search')       as HTMLInputElement;
  const regionFilterEl = document.getElementById('region-filter') as HTMLSelectElement;

  // ── Mark today on the calendar ────────────────────────────────────────────
  const todayKey = [
    YEAR,
    String(today.getMonth() + 1).padStart(2, '0'),
    String(today.getDate()).padStart(2, '0'),
  ].join('-');
  const todayCell = document.querySelector<HTMLElement>(`[data-caldate="${todayKey}"]`);
  if (todayCell) {
    if (todayCell.classList.contains('text-white')) {
      todayCell.classList.add('ring-2', 'ring-white', 'ring-offset-1', 'ring-offset-transparent');
    } else {
      todayCell.classList.add('ring-2', 'ring-slate-500', 'font-bold');
    }
  }

  // ── Calendar display ──────────────────────────────────────────────────────
  function renderCalendar(month: number) {
    document.querySelectorAll('.month-cal-grid, .month-events-list').forEach(el =>
      el.classList.add('hidden')
    );
    document.getElementById(`cal-grid-${month}`)?.classList.remove('hidden');
    document.getElementById(`month-list-${month}`)?.classList.remove('hidden');
    monthLabel.textContent = `${MONTH_NAMES[month]} ${YEAR}`;
    prevBtn.disabled = month === 0;
    nextBtn.disabled = month === 11;
  }

  // ── Card filtering ────────────────────────────────────────────────────────
  function applyFilters() {
    const q      = searchEl.value.toLowerCase();
    const region = regionFilterEl.value;
    let   visible = 0;
    items.forEach(item => {
      const matchMonth  = parseInt(item.dataset.month!) === calMonth;
      const matchText   = !q      || item.dataset.name!.includes(q) || item.dataset.description!.includes(q);
      const matchRegion = !region || item.dataset.region === region;
      const show = matchMonth && matchText && matchRegion;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    noResults.classList.toggle('hidden', visible > 0);
  }

  // ── Navigation ────────────────────────────────────────────────────────────
  function navigate(dir: -1 | 1) {
    const next = calMonth + dir;
    if (next < 0 || next > 11) return;
    calMonth = next;
    renderCalendar(calMonth);
    applyFilters();
  }

  prevBtn.addEventListener('click', () => navigate(-1));
  nextBtn.addEventListener('click', () => navigate(1));

  // ── Search / filter inputs ────────────────────────────────────────────────
  searchEl.addEventListener('input',        applyFilters);
  regionFilterEl.addEventListener('change', applyFilters);

  // ── Init ──────────────────────────────────────────────────────────────────
  renderCalendar(calMonth);
  applyFilters();
</script>
