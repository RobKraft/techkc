---
import Layout from '../layouts/Layout.astro';
import groups from '../data/groups.json';
import events from '../data/events.json';
import venues from '../data/venues.json';
import { eventDisplayTitle } from '../lib/events';

const activeGroups = groups.filter(g => g.active);

// ── Upcoming events ─────────────────────────────────────────────────────────
// The site is static, so "today" is only known in the browser. Render a
// generous buffer of events that haven't ended as of the build (minus a day of
// slack for time zones); the script below hides anything that has since ended
// and shows only the next UPCOMING_LIMIT.
const UPCOMING_LIMIT = 12;
const BUFFER = 80;

function dateKey(d: Date): string {
  return [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-');
}
const buildCutoff = new Date();
buildCutoff.setDate(buildCutoff.getDate() - 1);
const buildCutoffKey = dateKey(buildCutoff);

const upcoming = events
  .filter(e => !e.dateTBD && (e.endDate ?? e.date) >= buildCutoffKey)
  .sort((a, b) => a.date.localeCompare(b.date) || eventDisplayTitle(a).localeCompare(eventDisplayTitle(b)))
  .slice(0, BUFFER);

const upcomingAtBuild = events.filter(e => (e.endDate ?? e.date) >= buildCutoffKey).length;

const TYPE_BORDER: Record<string, string> = {
  Conference:   'border-purple-400',
  Hackathon:    'border-pink-400',
  Workshop:     'border-amber-400',
  Unconference: 'border-teal-400',
};

function shortDate(key: string): string {
  return new Date(key + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

// ── Groups strip: groups with something on the calendar soon ───────────────
const soon = new Date();
soon.setDate(soon.getDate() + 45);
const soonKey = dateKey(soon);
const groupsMeetingSoon = new Set(
  events.filter(e => e.group && e.date >= buildCutoffKey && e.date <= soonKey).map(e => e.group!),
);
const stripGroups = activeGroups
  .filter(g => groupsMeetingSoon.has(g.name))
  .sort((a, b) => a.name.localeCompare(b.name))
  .slice(0, 16);
---

<Layout title="Home" description="TechKC — upcoming tech events in Kansas City, plus the user groups, venues, and speakers behind them.">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-brand-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
      <div class="max-w-3xl">
        <div class="hidden sm:inline-flex items-center gap-2 bg-brand-600/20 border border-brand-500/30 text-brand-300 text-sm font-medium px-3 py-1.5 rounded-full mb-5">
          <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
          Kansas City's Tech Community Hub
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight mb-3 md:mb-4">
          What's happening in<br />
          <span class="text-brand-400">KC tech.</span>
        </h1>
        <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-5 md:mb-7 max-w-2xl">
          Meetups, conferences, and workshops across the Kansas City metro, from {activeGroups.length}+ local user groups. Always free to list.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/events" class="px-6 py-3 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-lg transition-colors">
            See the full calendar
          </a>
          <a href="/groups" class="px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold rounded-lg transition-colors">
            Browse groups
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming events -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Upcoming events</h2>
        <p class="text-slate-500 mt-1">The next few things on the KC tech calendar</p>
      </div>
      <a href="/events" class="shrink-0 text-brand-600 hover:text-brand-800 font-medium text-sm transition-colors">
        Full calendar &rarr;
      </a>
    </div>

    <ol id="upcoming-list" class="bg-white border border-slate-200 rounded-xl divide-y divide-slate-100 overflow-hidden">
      {upcoming.map((ev, i) => {
        const end = ev.endDate ?? ev.date;
        const multiDay = end !== ev.date;
        const bc = TYPE_BORDER[ev.type] ?? 'border-brand-400';
        return (
          <li
            class={`upcoming-item ${i >= UPCOMING_LIMIT ? 'hidden' : ''}`}
            data-start={ev.date}
            data-end={end}
          >
            <a href={ev.url} target="_blank" rel="noopener"
              class={`flex gap-4 px-4 sm:px-5 py-3.5 border-l-4 ${bc} hover:bg-slate-50 transition-colors group`}>
              <div class="w-[4.5rem] sm:w-28 shrink-0 text-sm">
                <div class="upcoming-when font-semibold text-slate-800">{shortDate(ev.date)}</div>
                {multiDay && <div class="text-xs text-slate-400">through {shortDate(end)}</div>}
              </div>
              <div class="flex-1 min-w-0">
                <div class="font-semibold text-slate-900 group-hover:text-brand-700 transition-colors leading-snug">
                  {eventDisplayTitle(ev)}
                </div>
                <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
                  <span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{ev.type}</span>
                  {ev.location && ev.location !== 'Kansas City, MO' && <span>{ev.location}</span>}
                  {ev.cost === 'Free' && <span class="text-emerald-600 font-medium">Free</span>}
                </div>
              </div>
              <span class="hidden sm:block self-center text-sm text-brand-600 opacity-0 group-hover:opacity-100 transition-opacity">
                Details &rarr;
              </span>
            </a>
          </li>
        );
      })}
    </ol>

    <p id="upcoming-empty" class="hidden bg-white border border-slate-200 rounded-xl text-center text-slate-500 py-10 text-sm">
      Nothing on the calendar yet.
      <a href="/submit#event" class="text-brand-600 hover:underline">Know of an event? Add it.</a>
    </p>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
      <a href="/events" class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg transition-colors">
        See all upcoming events &rarr;
      </a>
      <a href="/submit#event" class="text-brand-600 hover:text-brand-800 font-medium transition-colors">
        Know of an event that isn't listed? Add it &rarr;
      </a>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-extrabold text-brand-700">{activeGroups.length}+</div>
          <div class="text-sm text-slate-500 mt-1">Active Groups</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-brand-700">{upcomingAtBuild}</div>
          <div class="text-sm text-slate-500 mt-1">Upcoming Events</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-brand-700">{venues.length}</div>
          <div class="text-sm text-slate-500 mt-1">Meetup Venues</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-brand-700">Free</div>
          <div class="text-sm text-slate-500 mt-1">Always Free to List</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Groups strip -->
  {stripGroups.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Groups meeting soon</h2>
          <p class="text-slate-500 mt-1">Find a group and become a regular</p>
        </div>
        <a href="/groups" class="shrink-0 text-brand-600 hover:text-brand-800 font-medium text-sm transition-colors">
          View all {activeGroups.length} groups &rarr;
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {stripGroups.map(g => (
          <a href={g.url} target="_blank" rel="noopener"
            class="px-3 py-1.5 bg-white border border-slate-200 rounded-full text-sm text-slate-700 hover:border-brand-300 hover:text-brand-700 transition-colors">
            {g.name}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Community CTA strip -->
  <section class="bg-brand-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 bg-brand-600 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="font-semibold text-lg">Find a Venue</h3>
          <p class="text-brand-200 text-sm">Discover free and low-cost spaces to host your next meetup.</p>
          <a href="/venues" class="text-accent-400 hover:text-accent-300 font-medium text-sm transition-colors">Browse venues &rarr;</a>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 bg-brand-600 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0" />
            </svg>
          </div>
          <h3 class="font-semibold text-lg">All Tech Groups</h3>
          <p class="text-brand-200 text-sm">{activeGroups.length} active user groups meeting across the KC metro.</p>
          <a href="/groups" class="text-accent-400 hover:text-accent-300 font-medium text-sm transition-colors">Browse groups &rarr;</a>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 bg-brand-600 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <h3 class="font-semibold text-lg">List Your Group or Event</h3>
          <p class="text-brand-200 text-sm">Add a group, event, venue, or speaker. Always free.</p>
          <a href="/submit" class="text-accent-400 hover:text-accent-300 font-medium text-sm transition-colors">Submit a listing &rarr;</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Resolve "today" in the visitor's browser: hide events that have ended,
  // show the next UPCOMING_LIMIT, and label today/tomorrow/this week.
  const UPCOMING_LIMIT = 12;

  function dateKey(d: Date): string {
    return [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-');
  }
  const now = new Date();
  const todayKey = dateKey(now);
  const tomorrow = new Date(now);
  tomorrow.setDate(now.getDate() + 1);
  const tomorrowKey = dateKey(tomorrow);
  const weekOut = new Date(now);
  weekOut.setDate(now.getDate() + 6);
  const weekOutKey = dateKey(weekOut);

  const items = document.querySelectorAll<HTMLElement>('.upcoming-item');
  let shown = 0;
  items.forEach(item => {
    const start = item.dataset.start!;
    const end = item.dataset.end!;
    const show = end >= todayKey && shown < UPCOMING_LIMIT;
    item.classList.toggle('hidden', !show);
    if (!show) return;
    shown++;

    const when = item.querySelector<HTMLElement>('.upcoming-when')!;
    if (start <= todayKey) {
      when.textContent = start < todayKey ? 'Happening now' : 'Today';
      when.classList.add('text-brand-700');
    } else if (start === tomorrowKey) {
      when.textContent = 'Tomorrow';
      when.classList.add('text-brand-700');
    } else if (start <= weekOutKey) {
      const d = new Date(start + 'T12:00:00');
      when.textContent = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
    }
  });

  document.getElementById('upcoming-list')!.classList.toggle('hidden', shown === 0);
  document.getElementById('upcoming-empty')!.classList.toggle('hidden', shown > 0);
</script>
