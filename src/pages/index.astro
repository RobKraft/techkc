---
import Layout from '../layouts/Layout.astro';
import GroupCard from '../components/GroupCard.astro';
import EventCard from '../components/EventCard.astro';
import groups from '../data/groups.json';
import events from '../data/events.json';

const featuredGroups = groups.filter(g => g.active).slice(0, 6);
const upcomingEvents = events.slice(0, 3);
---

<Layout title="Home" description="TechKC — Kansas City's central hub for tech community groups, events, venues, and speakers.">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-brand-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-brand-600/20 border border-brand-500/30 text-brand-300 text-sm font-medium px-3 py-1.5 rounded-full mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
          Kansas City's Tech Community Hub
        </div>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6">
          Connect with KC's<br />
          <span class="text-brand-400">tech community.</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-8 max-w-2xl">
          Find local user groups, regional conferences, meeting venues, and speakers — everything you need to engage with the Kansas City tech scene.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/groups" class="px-6 py-3 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-lg transition-colors">
            Browse Groups
          </a>
          <a href="/submit" class="px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold rounded-lg transition-colors">
            Submit / Update a Listing
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-extrabold text-brand-700">{groups.filter(g => g.active).length}+</div>
          <div class="text-sm text-slate-500 mt-1">Active Groups</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-brand-700">{events.length}</div>
          <div class="text-sm text-slate-500 mt-1">Regional Events</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-brand-700">6+</div>
          <div class="text-sm text-slate-500 mt-1">Meetup Venues</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-brand-700">Free</div>
          <div class="text-sm text-slate-500 mt-1">Always Free to List</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Groups -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Active Tech Groups</h2>
        <p class="text-slate-500 mt-1">Regular meetups in Kansas City and the surrounding metro</p>
      </div>
      <a href="/groups" class="text-brand-600 hover:text-brand-800 font-medium text-sm transition-colors">
        View all {groups.filter(g => g.active).length} groups &rarr;
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredGroups.map(group => <GroupCard group={group} />)}
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="bg-slate-100 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Regional Events</h2>
          <p class="text-slate-500 mt-1">Conferences, hackathons, and major events in the KC region</p>
        </div>
        <a href="/events" class="text-brand-600 hover:text-brand-800 font-medium text-sm transition-colors">
          View all events &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {upcomingEvents.map(event => <EventCard event={event} />)}
      </div>
    </div>
  </section>

  <!-- Community CTA strip -->
  <section class="bg-brand-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 bg-brand-600 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="font-semibold text-lg">Find a Venue</h3>
          <p class="text-brand-200 text-sm">Discover free and low-cost spaces to host your next meetup.</p>
          <a href="/venues" class="text-accent-400 hover:text-accent-300 font-medium text-sm transition-colors">Browse venues &rarr;</a>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 bg-brand-600 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="font-semibold text-lg">Find a Speaker</h3>
          <p class="text-brand-200 text-sm">Browse local speakers and what they want to present.</p>
          <a href="/speakers" class="text-accent-400 hover:text-accent-300 font-medium text-sm transition-colors">Browse speakers &rarr;</a>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 bg-brand-600 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
          </div>
          <h3 class="font-semibold text-lg">Add Your Group</h3>
          <p class="text-brand-200 text-sm">Running a KC tech group? Get listed — it's free and easy.</p>
          <a href="/submit" class="text-accent-400 hover:text-accent-300 font-medium text-sm transition-colors">Submit a listing &rarr;</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
