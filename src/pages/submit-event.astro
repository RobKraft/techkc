---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Submit Event" description="Organizer event submission for TechKC.">

  <section class="bg-slate-900 text-white py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3">Submit an Event</h1>
      <p class="text-slate-300 text-lg">
        For trusted organizers. Log in, then submit, edit, or remove your events — every change opens a pull request for review before it goes live.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <div id="auth-loading" class="text-center py-12 text-slate-500">Loading…</div>

    <div id="auth-login" class="hidden text-center py-12">
      <p class="text-slate-600 mb-4">You need to log in to submit an event.</p>
      <button id="login-btn" type="button" class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg text-sm transition-colors">
        Log in
      </button>
    </div>

    <div id="auth-form" class="hidden">
      <div class="flex items-center justify-between mb-6">
        <p class="text-sm text-slate-500">Logged in as <span id="user-name" class="font-medium text-slate-700"></span></p>
        <button id="logout-btn" type="button" class="text-sm text-slate-500 hover:text-brand-600">Log out</button>
      </div>

      <div id="my-events" class="hidden mb-10">
        <h2 class="text-xl font-bold text-slate-900 mb-1">Your events</h2>
        <p class="text-sm text-slate-500 mb-3">Events you submitted that are live on the site. Changes and removals are reviewed before they take effect.</p>
        <ul id="my-events-list" class="divide-y divide-slate-200 border border-slate-200 rounded-lg bg-white"></ul>
        <p id="list-status" class="text-sm mt-3 hidden"></p>
      </div>

      <div class="flex items-center justify-between mb-4">
        <h2 id="form-heading" class="text-xl font-bold text-slate-900">Submit a new event</h2>
        <button id="cancel-edit" type="button" class="hidden text-sm text-slate-500 hover:text-brand-600">Cancel edit</button>
      </div>

      <form id="event-form" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-name">Event name *</label>
          <input id="f-name" name="name" type="text" required maxlength="200" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-group">Organizing group/org (optional)</label>
          <input id="f-group" name="group" type="text" maxlength="200" placeholder="e.g. Agile KC" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-url">Event website *</label>
            <input id="f-url" name="url" type="url" required maxlength="500" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-type">Event type *</label>
            <select id="f-type" name="type" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white">
              <option value="">Select...</option>
              <option>Conference</option>
              <option>Hackathon</option>
              <option>Workshop</option>
              <option>Meetup</option>
              <option>Unconference</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-date">Start date *</label>
            <input id="f-date" name="date" type="date" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-enddate">End date (if multi-day)</label>
            <input id="f-enddate" name="endDate" type="date" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-location">Location (optional)</label>
          <input id="f-location" name="location" type="text" maxlength="200" placeholder="e.g. Kansas City, MO" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-description">Description (optional)</label>
          <textarea id="f-description" name="description" rows="3" maxlength="2000" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"></textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5" for="f-tags">Tags (comma-separated)</label>
          <input id="f-tags" name="tags" type="text" placeholder="e.g. AI, Community, Meetup" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>

        <button type="submit" id="submit-btn" class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg text-sm transition-colors disabled:opacity-50 disabled:pointer-events-none">
          Submit Event
        </button>

        <p id="form-status" class="text-sm hidden"></p>
      </form>
    </div>

  </section>

</Layout>

<script>
  import { createAuth0Client } from '@auth0/auth0-spa-js';

  const domain   = import.meta.env.PUBLIC_AUTH0_DOMAIN;
  const clientId = import.meta.env.PUBLIC_AUTH0_CLIENT_ID;
  const audience = import.meta.env.PUBLIC_AUTH0_AUDIENCE;

  interface MyEvent {
    id: string;
    name: string;
    group?: string;
    description?: string;
    url: string;
    date: string;
    endDate?: string;
    location?: string;
    type: string;
    tags?: string[];
  }
  interface Defaults { group?: string; url?: string; type?: string; location?: string }

  const PREFILL_KEYS = ['group', 'url', 'type', 'location'] as const;

  const loadingEl    = document.getElementById('auth-loading')!;
  const loginEl      = document.getElementById('auth-login')!;
  const formWrapEl   = document.getElementById('auth-form')!;
  const loginBtn     = document.getElementById('login-btn')!;
  const logoutBtn    = document.getElementById('logout-btn')!;
  const userNameEl   = document.getElementById('user-name')!;
  const eventForm    = document.getElementById('event-form') as HTMLFormElement;
  const submitBtn    = document.getElementById('submit-btn') as HTMLButtonElement;
  const statusEl     = document.getElementById('form-status')!;
  const listStatusEl = document.getElementById('list-status')!;
  const myEventsEl   = document.getElementById('my-events')!;
  const myListEl     = document.getElementById('my-events-list')!;
  const headingEl    = document.getElementById('form-heading')!;
  const cancelBtn    = document.getElementById('cancel-edit')!;

  const field = (name: string) => eventForm.elements.namedItem(name) as HTMLInputElement;

  function setStatus(el: HTMLElement, kind: 'error' | 'success', message: string, linkUrl?: string) {
    el.textContent = '';
    el.classList.remove('hidden', 'text-red-600', 'text-emerald-600');
    el.classList.add(kind === 'error' ? 'text-red-600' : 'text-emerald-600');
    el.append(message);
    if (linkUrl) {
      el.append(' ');
      const link = document.createElement('a');
      link.href = linkUrl;
      link.target = '_blank';
      link.rel = 'noopener';
      link.className = 'underline';
      link.textContent = 'View the pull request';
      el.append(link);
    }
  }

  function formatDate(iso: string) {
    return new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  async function init() {
    if (!domain || !clientId) {
      loadingEl.textContent = 'Submission is not configured yet.';
      return;
    }

    const redirectUri = window.location.origin + window.location.pathname;

    const auth0 = await createAuth0Client({
      domain,
      clientId,
      authorizationParams: {
        redirect_uri: redirectUri,
        audience,
        scope: 'openid profile email',
      },
    });

    const query = window.location.search;
    if (query.includes('code=') && query.includes('state=')) {
      try {
        await auth0.handleRedirectCallback();
      } catch {
        // fall through to the normal auth check below
      }
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    const isAuthenticated = await auth0.isAuthenticated();
    loadingEl.classList.add('hidden');

    if (!isAuthenticated) {
      loginEl.classList.remove('hidden');
      loginBtn.addEventListener('click', () => auth0.loginWithRedirect());
      return;
    }

    const user = await auth0.getUser();
    userNameEl.textContent = user?.name ?? user?.email ?? 'you';
    formWrapEl.classList.remove('hidden');

    logoutBtn.addEventListener('click', () =>
      auth0.logout({ logoutParams: { returnTo: redirectUri } })
    );

    // ── Remembered details (pre-fill) ─────────────────────────────────────
    // Two sources: what this person submitted last on this device, and what
    // their most recent live events on the site look like (works on any device).
    const storageKey = `techkc-submitter-defaults:${user?.sub ?? 'anon'}`;
    let serverDefaults: Defaults = {};

    function readLocalDefaults(): Defaults {
      try { return JSON.parse(localStorage.getItem(storageKey) ?? '{}'); } catch { return {}; }
    }
    function saveLocalDefaults(values: Defaults) {
      try { localStorage.setItem(storageKey, JSON.stringify(values)); } catch { /* storage unavailable */ }
    }
    function applyDefaults() {
      const defaults = { ...serverDefaults, ...readLocalDefaults() };
      for (const key of PREFILL_KEYS) {
        const input = field(key);
        if (!input.value && defaults[key]) input.value = defaults[key]!;
      }
    }

    // ── Edit mode ─────────────────────────────────────────────────────────
    let editingId: string | null = null;

    function setFormMode(editing: MyEvent | null) {
      editingId = editing?.id ?? null;
      headingEl.textContent = editing ? `Edit: ${editing.name}` : 'Submit a new event';
      submitBtn.textContent = editing ? 'Submit changes' : 'Submit Event';
      cancelBtn.classList.toggle('hidden', !editing);
      statusEl.classList.add('hidden');
    }

    function startEdit(ev: MyEvent) {
      eventForm.reset();
      setFormMode(ev);
      field('name').value        = ev.name;
      field('group').value       = ev.group ?? '';
      field('url').value         = ev.url;
      field('type').value        = ev.type;
      field('date').value        = ev.date;
      field('endDate').value     = ev.endDate && ev.endDate !== ev.date ? ev.endDate : '';
      field('location').value    = ev.location ?? '';
      field('description').value = ev.description ?? '';
      field('tags').value        = (ev.tags ?? []).join(', ');
      headingEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function stopEdit() {
      eventForm.reset();
      setFormMode(null);
      applyDefaults();
    }

    cancelBtn.addEventListener('click', stopEdit);

    // ── Authenticated calls ───────────────────────────────────────────────
    async function api(path: string, init: { method: 'GET' | 'POST'; body?: unknown }) {
      const token = await auth0.getTokenSilently();
      const res = await fetch(`/.netlify/functions/${path}`, {
        method: init.method,
        headers: {
          authorization: `Bearer ${token}`,
          ...(init.body ? { 'content-type': 'application/json' } : {}),
        },
        body: init.body ? JSON.stringify(init.body) : undefined,
      });
      const data = await res.json().catch(() => ({}));
      return { ok: res.ok, data };
    }

    // ── "Your events" list ────────────────────────────────────────────────
    function markPending(row: HTMLElement, label: string) {
      row.querySelectorAll('button').forEach(b => { (b as HTMLButtonElement).disabled = true; });
      const note = document.createElement('span');
      note.className = 'text-xs text-amber-600 font-medium';
      note.textContent = label;
      row.querySelector('[data-actions]')!.prepend(note);
    }

    const rowsById = new Map<string, HTMLElement>();

    function renderMyEvents(events: MyEvent[]) {
      myListEl.textContent = '';
      rowsById.clear();
      myEventsEl.classList.toggle('hidden', events.length === 0);

      for (const ev of events) {
        const row = document.createElement('li');
        rowsById.set(ev.id, row);
        row.className = 'flex flex-wrap items-center justify-between gap-3 px-4 py-3';

        const info = document.createElement('div');
        info.className = 'min-w-0';
        const title = document.createElement('p');
        title.className = 'text-sm font-medium text-slate-900 truncate';
        title.textContent = ev.name;
        const when = document.createElement('p');
        when.className = 'text-xs text-slate-500';
        when.textContent = formatDate(ev.date);
        info.append(title, when);

        const actions = document.createElement('div');
        actions.dataset.actions = '';
        actions.className = 'flex items-center gap-3 shrink-0';

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'text-sm text-brand-600 hover:text-brand-800 font-medium disabled:opacity-40 disabled:pointer-events-none';
        editBtn.textContent = 'Edit';
        editBtn.addEventListener('click', () => startEdit(ev));

        const deleteBtn = document.createElement('button');
        deleteBtn.type = 'button';
        deleteBtn.className = 'text-sm text-red-600 hover:text-red-800 font-medium disabled:opacity-40 disabled:pointer-events-none';
        deleteBtn.textContent = 'Delete';
        deleteBtn.addEventListener('click', async () => {
          if (!confirm(`Request removal of "${ev.name}"? It stays on the site until the removal is reviewed.`)) return;
          deleteBtn.disabled = true;
          listStatusEl.classList.add('hidden');
          try {
            const { ok, data } = await api('delete-event', { method: 'POST', body: { id: ev.id } });
            if (!ok) {
              setStatus(listStatusEl, 'error', data.error ?? 'Something went wrong.');
              deleteBtn.disabled = false;
              return;
            }
            setStatus(listStatusEl, 'success', 'Removal requested.', data.prUrl);
            markPending(row, 'Removal pending review');
            if (editingId === ev.id) stopEdit();
          } catch {
            setStatus(listStatusEl, 'error', 'Something went wrong requesting the removal.');
            deleteBtn.disabled = false;
          }
        });

        actions.append(editBtn, deleteBtn);
        row.append(info, actions);
        myListEl.append(row);
      }
    }

    async function loadMyEvents() {
      try {
        const { ok, data } = await api('my-events', { method: 'GET' });
        if (!ok) return;
        serverDefaults = data.defaults ?? {};
        renderMyEvents(data.events ?? []);
        if (!editingId) applyDefaults();
      } catch {
        // The list and pre-fill are conveniences; submitting still works without them.
      }
    }

    applyDefaults();
    loadMyEvents();

    // ── Submit (new or edit) ──────────────────────────────────────────────
    eventForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      statusEl.classList.add('hidden');

      const formData = new FormData(eventForm);
      const text = (name: string) => String(formData.get(name) ?? '').trim() || undefined;
      const tagsRaw = String(formData.get('tags') ?? '');
      const payload = {
        name: text('name'),
        group: text('group'),
        url: text('url'),
        type: text('type'),
        date: text('date'),
        endDate: text('endDate'),
        location: text('location'),
        description: text('description'),
        tags: tagsRaw ? tagsRaw.split(',').map(t => t.trim()).filter(Boolean) : [],
      };
      const wasEditing = editingId;

      try {
        const { ok, data } = wasEditing
          ? await api('edit-event', { method: 'POST', body: { id: wasEditing, ...payload } })
          : await api('submit-event', { method: 'POST', body: payload });

        if (!ok) {
          setStatus(statusEl, 'error', data.error ?? 'Something went wrong.');
          return;
        }

        saveLocalDefaults({
          group: payload.group,
          url: payload.url,
          type: payload.type,
          location: payload.location,
        });

        if (wasEditing) {
          stopEdit();
          setStatus(statusEl, 'success', 'Change submitted for review.', data.prUrl);
          const row = rowsById.get(wasEditing);
          if (row) markPending(row, 'Change pending review');
        } else {
          setStatus(statusEl, 'success', 'Submitted!', data.prUrl);
          eventForm.reset();
          setTimeout(() => { window.location.href = '/'; }, 2200);
        }
      } catch {
        setStatus(statusEl, 'error', 'Something went wrong submitting the event.');
      } finally {
        submitBtn.disabled = false;
      }
    });
  }

  init();
</script>
