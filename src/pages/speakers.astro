---
import Layout from '../layouts/Layout.astro';
import speakers from '../data/speakers.json';
---

<Layout title="Speakers" description="KC-area tech speakers available to present at user groups and conferences.">

  <section class="bg-slate-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3">Speaker Directory</h1>
      <p class="text-slate-300 text-lg max-w-2xl">
        Kansas City–area speakers available to present at user groups and conferences. Browse by topic or <a href="/submit#speaker" class="text-brand-400 hover:text-brand-300 underline">add yourself to the list</a>.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Sessionize callout -->
    <div class="bg-brand-50 border border-brand-200 rounded-xl p-5 mb-10 flex flex-col sm:flex-row gap-4 items-start">
      <div class="shrink-0 w-10 h-10 bg-brand-600 rounded-lg flex items-center justify-center text-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-brand-900 mb-1">Have a Sessionize profile?</h3>
        <p class="text-sm text-brand-800 leading-relaxed">
          When you submit your speaker profile below, include your <a href="https://sessionize.com" target="_blank" rel="noopener" class="underline hover:text-brand-600">Sessionize.com</a> profile URL.
          We'll link directly to it so user groups can see your full bio, session history, and ratings.
        </p>
      </div>
    </div>

    <div id="speakers-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {speakers.map(speaker => (
        <article class="bg-white rounded-xl border border-slate-200 p-5 hover:shadow-md hover:border-brand-200 transition-all flex flex-col gap-3">
          <div class="flex items-start justify-between gap-2">
            <h2 class="font-semibold text-slate-900">{speaker.name}</h2>
            <span class="shrink-0 text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{speaker.location}</span>
          </div>

          <p class="text-sm text-slate-600 leading-relaxed flex-1">{speaker.bio}</p>

          <div class="flex flex-wrap gap-1.5">
            {speaker.topics.map(t => (
              <span class="text-xs bg-brand-50 text-brand-700 border border-brand-100 px-2 py-0.5 rounded-full">{t}</span>
            ))}
          </div>

          <div class="pt-1 border-t border-slate-100 text-sm space-y-1">
            <p class="text-slate-500">
              Available for: {speaker.availableFor.join(', ')}
            </p>
            {speaker.travelWilling && (
              <p class="text-emerald-600 font-medium text-xs">Willing to travel</p>
            )}
            {speaker.sessionizeUrl && (
              <a href={speaker.sessionizeUrl} target="_blank" rel="noopener" class="block text-brand-600 hover:text-brand-800 font-medium transition-colors">
                Sessionize profile &rarr;
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    {speakers.length === 0 && (
      <div class="text-center py-16 text-slate-500">
        <p class="text-lg mb-4">No speakers listed yet.</p>
        <a href="/submit#speaker" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg text-sm transition-colors">
          Be the first to list yourself &rarr;
        </a>
      </div>
    )}
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-center">
      <h3 class="text-lg font-semibold text-slate-900 mb-2">Want to speak at KC user groups?</h3>
      <p class="text-slate-600 mb-4 max-w-lg mx-auto text-sm">
        Add yourself to the directory — include your topics, availability, and Sessionize profile link.
      </p>
      <a href="/submit#speaker" class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg text-sm transition-colors">
        Add yourself as a speaker &rarr;
      </a>
    </div>
  </section>

</Layout>
