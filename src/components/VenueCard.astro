---
interface Props {
  venue: {
    id: string;
    name: string;
    description: string;
    address: string;
    url: string;
    capacity: number | null;
    cost: string;
    amenities: string[];
    neighborhood: string;
  };
}

const { venue } = Astro.props;
---

<article class="bg-white rounded-xl border border-slate-200 p-5 hover:shadow-md hover:border-brand-200 transition-all flex flex-col gap-3">
  <div>
    <div class="flex items-start justify-between gap-2 mb-1">
      <h2 class="font-semibold text-slate-900 leading-snug">
        <a href={venue.url} target="_blank" rel="noopener" class="hover:text-brand-700 transition-colors">
          {venue.name}
        </a>
      </h2>
      <span class="shrink-0 text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{venue.neighborhood}</span>
    </div>
  </div>

  <p class="text-sm text-slate-600 leading-relaxed flex-1">{venue.description}</p>

  <div class="flex flex-wrap gap-1.5">
    {venue.amenities.map(a => (
      <span class="text-xs bg-brand-50 text-brand-700 border border-brand-100 px-2 py-0.5 rounded-full">{a}</span>
    ))}
  </div>

  <div class="pt-1 border-t border-slate-100 space-y-1 text-sm text-slate-500">
    <div class="flex items-center gap-1.5">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0" />
      </svg>
      Capacity: {venue.capacity ?? 'Contact for details'}
    </div>
    <div class="flex items-center gap-1.5">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
      </svg>
      {venue.address}
    </div>
    <div class="flex items-center justify-between">
      <span class={venue.cost.startsWith('Free') ? 'text-emerald-600 font-medium' : ''}>{venue.cost}</span>
      <a href={venue.url} target="_blank" rel="noopener" class="text-brand-600 hover:text-brand-800 font-medium transition-colors">
        Visit site &rarr;
      </a>
    </div>
  </div>
</article>
