---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">

      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-7 h-7 bg-brand-600 rounded-lg flex items-center justify-center font-bold text-xs text-white">KC</div>
          <span class="font-bold text-white text-lg">Tech<span class="text-brand-400">KC</span></span>
        </div>
        <p class="text-sm leading-relaxed max-w-xs">
          The central hub for Kansas City's tech community — groups, events, and venues all in one place.
        </p>
        <p class="text-sm mt-4">
          Formerly <a href="https://www.kansascityusergroups.com" class="text-brand-400 hover:text-brand-300 transition-colors" target="_blank" rel="noopener">kansascityusergroups.com</a>
          &nbsp;·&nbsp;<a href="https://kansascityusergroups.blogspot.com" class="text-brand-400 hover:text-brand-300 transition-colors" target="_blank" rel="noopener">Old blog</a>
        </p>
      </div>

      <div>
        <h3 class="text-white font-semibold text-sm mb-3">Explore</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/groups" class="hover:text-white transition-colors">Tech Groups</a></li>
          <li><a href="/events" class="hover:text-white transition-colors">Events</a></li>
          <li><a href="/venues" class="hover:text-white transition-colors">Venues</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-10 pt-6 text-sm flex flex-col sm:flex-row justify-between gap-2">
      <p>&copy; {year} TechKC — techkc.org. Community-maintained.</p>
      <p>
        <a href="https://github.com/techkc/techkc.org" class="hover:text-white transition-colors" target="_blank" rel="noopener">
          Open source on GitHub
        </a>
      </p>
    </div>
  </div>
</footer>
