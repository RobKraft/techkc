---
interface Props {
  event: {
    id: string;
    name: string;
    description: string;
    url: string;
    date: string;
    endDate?: string;
    dateTBD?: boolean;
    location: string;
    type: string;
    cost: string;
    tags: string[];
  };
}

const { event } = Astro.props;

const start = new Date(event.date + 'T12:00:00');
const end   = event.endDate ? new Date(event.endDate + 'T12:00:00') : null;

const monthYear = start.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const dateLabel = event.dateTBD
  ? `${monthYear} (date TBD)`
  : end && event.endDate !== event.date
    ? `${start.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}–${end.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`
    : start.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

---

<article class="bg-white rounded-xl border border-slate-200 p-5 hover:shadow-md hover:border-brand-200 transition-all flex flex-col gap-3">
  <h2 class="font-semibold text-slate-900 leading-snug">
    <a href={event.url} target="_blank" rel="noopener" class="hover:text-brand-700 transition-colors">
      {event.name}
    </a>
  </h2>

  <p class="text-sm text-slate-600 leading-relaxed flex-1">{event.description}</p>

  <div class="flex flex-wrap gap-1.5">
    {event.tags.map(tag => (
      <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{tag}</span>
    ))}
  </div>

  <div class="pt-1 border-t border-slate-100 space-y-1 text-sm text-slate-500">
    <div class="flex items-center gap-1.5">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      {dateLabel}
    </div>
    <div class="flex items-center gap-1.5">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {event.location}
    </div>
    <div class="flex items-center justify-between">
      <span class={event.cost === 'Free' ? 'text-emerald-600 font-medium' : ''}>{event.cost}</span>
      <a href={event.url} target="_blank" rel="noopener" class="text-brand-600 hover:text-brand-800 font-medium transition-colors">
        Details &rarr;
      </a>
    </div>
  </div>
</article>
