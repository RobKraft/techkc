# Auth0 (Single Page Application + API) — not secret, safe to expose client-side.
# Astro exposes any PUBLIC_* var to the browser bundle.
PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
PUBLIC_AUTH0_CLIENT_ID=your-spa-client-id
PUBLIC_AUTH0_AUDIENCE=https://your-site.example/api

# GitHub — a fine-grained Personal Access Token scoped to ONLY the techkc repo,
# with Contents (read/write) and Pull requests (read/write) permissions.
# Server-side only — never exposed to the browser. Do not prefix with PUBLIC_.
GITHUB_TOKEN=

# Secret used to record who submitted each event (HMAC of their email, stored as
# "owner" in events.json) so people can edit/delete only their own events. Server-side
# only. Generate once (e.g. `openssl rand -hex 32`) and NEVER change it afterwards:
# changing it orphans every existing owner. Without it, submissions still work but
# record no owner, and the edit/delete/my-events endpoints return 503.
OWNER_HASH_SECRET=

# Optional extra allowlist beyond "has an Auth0 account" — comma-separated emails.
# Leave unset to trust Auth0 account existence alone.
ALLOWED_SUBMITTER_EMAILS=

# Resend — confirmation email to the submitter. Optional: leave RESEND_API_KEY
# unset and the function just skips sending (the PR still gets created either way).
# IMPORTANT: without a verified sending domain in Resend, you can only send to
# your own account email, not real submitters — see resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TechKC <noreply@techkc.org>
